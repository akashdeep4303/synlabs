# Copy to .env. Never commit real secrets.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
GENERATOR_MODEL=llama3.2:3b
JUDGE_MODEL=llama3.2:3b

CHROMA_PATH=./data/chroma
COLLECTION_NAME=nimbusledger
